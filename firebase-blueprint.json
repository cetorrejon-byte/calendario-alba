{
  "entities": {
    "CampaignConfig": {
      "title": "CampaignConfig",
      "description": "Public configuration, schedule, contact handles, conditions, and test controls for Alba’s Beauty Salón Advent Calendar 2026.",
      "type": "object",
      "properties": {
        "salonName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "campaignYear": { "type": "integer" },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "minLength": 10, "maxLength": 10 },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "minLength": 10, "maxLength": 10 },
        "openHour": { "type": "integer" },
        "openMinute": { "type": "integer" },
        "closeHour": { "type": "integer" },
        "closeMinute": { "type": "integer" },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 40 },
        "validityEndDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "minLength": 10, "maxLength": 10 },
        "whatsappNumber": { "type": "string", "pattern": "^[0-9]{9,15}$", "minLength": 9, "maxLength": 15 },
        "instagramHandle": { "type": "string", "minLength": 2, "maxLength": 60 },
        "tiktokHandle": { "type": "string", "minLength": 2, "maxLength": 60 },
        "locationText": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slogan": { "type": "string", "minLength": 5, "maxLength": 220 },
        "conditions": { "type": "array" },
        "founderPhotoUrl": { "type": "string", "minLength": 5, "maxLength": 200000 },
        "founderPhotoMode": { "type": "string", "enum": ["fixed", "editable"] },
        "simulationIso": { "type": "string", "maxLength": 40 },
        "testUnlockAll": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "salonName",
        "campaignYear",
        "startDate",
        "endDate",
        "openHour",
        "openMinute",
        "closeHour",
        "closeMinute",
        "timezone",
        "validityEndDate",
        "whatsappNumber",
        "instagramHandle",
        "tiktokHandle",
        "locationText",
        "slogan",
        "conditions",
        "founderPhotoUrl",
        "founderPhotoMode",
        "testUnlockAll",
        "updatedAt"
      ]
    },
    "CalendarDoor": {
      "title": "CalendarDoor",
      "description": "One of the 24 numbered Advent doors (01-24) with its prize details and atomic claim state.",
      "type": "object",
      "properties": {
        "day": { "type": "integer" },
        "prizeTitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "prizeDescription": { "type": "string", "minLength": 5, "maxLength": 500 },
        "prizeCategory": { "type": "string", "minLength": 2, "maxLength": 40 },
        "status": { "type": "string", "enum": ["available", "claimed"] },
        "claimCode": { "type": "string", "pattern": "^ALBA26-D(0[1-9]|1[0-9]|2[0-4])-[A-Z0-9]{6}$", "maxLength": 20 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["day", "prizeTitle", "prizeDescription", "prizeCategory", "status", "updatedAt"]
    },
    "PrizeClaim": {
      "title": "PrizeClaim",
      "description": "Atomic winner record keyed by unguessable claimCode; zero visitor PII stored.",
      "type": "object",
      "properties": {
        "day": { "type": "integer" },
        "prizeTitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "prizeDescription": { "type": "string", "minLength": 5, "maxLength": 500 },
        "prizeCategory": { "type": "string", "minLength": 2, "maxLength": 40 },
        "claimCode": { "type": "string", "pattern": "^ALBA26-D(0[1-9]|1[0-9]|2[0-4])-[A-Z0-9]{6}$", "minLength": 17, "maxLength": 17 },
        "winnerRef": { "type": "string", "pattern": "^GAN-(0[1-9]|1[0-9]|2[0-4])-[A-F0-9]{8}$", "minLength": 15, "maxLength": 15 },
        "claimedAt": { "type": "string", "format": "date-time" },
        "claimedAtMadrid": { "type": "string", "minLength": 8, "maxLength": 40 },
        "redemptionStatus": { "type": "string", "enum": ["pending", "redeemed"] },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "redeemedAtMadrid": { "type": "string", "maxLength": 40 },
        "redeemedNote": { "type": "string", "maxLength": 240 }
      },
      "required": [
        "day",
        "prizeTitle",
        "prizeDescription",
        "prizeCategory",
        "claimCode",
        "winnerRef",
        "claimedAt",
        "claimedAtMadrid",
        "redemptionStatus"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit trail for prize edits, redemptions, test resets, and config changes.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "minLength": 2, "maxLength": 60 },
        "details": { "type": "string", "minLength": 2, "maxLength": 500 },
        "actor": { "type": "string", "minLength": 2, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdAtMadrid": { "type": "string", "minLength": 8, "maxLength": 40 }
      },
      "required": ["action", "details", "actor", "createdAt", "createdAtMadrid"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin email allowlist document managed by the bootstrapped owner.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 5, "maxLength": 120 },
        "addedBy": { "type": "string", "minLength": 5, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedBy", "createdAt"]
    }
  },
  "firestore": {
    "/campaign/{configId}": {
      "schema": { "$ref": "#/entities/CampaignConfig" },
      "description": "Singleton campaign configuration document at /campaign/config."
    },
    "/doors/{dayId}": {
      "schema": { "$ref": "#/entities/CalendarDoor" },
      "description": "24 Advent doors keyed by two-digit day ID ('01' through '24')."
    },
    "/claims/{claimCode}": {
      "schema": { "$ref": "#/entities/PrizeClaim" },
      "description": "Winner prize claim records keyed by unique claimCode (ALBA26-DXX-XXXXXX)."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only administrative activity log entries."
    },
    "/admins/{email}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Additional authorized administrator emails managed by bootstrapped admin."
    }
  }
}
