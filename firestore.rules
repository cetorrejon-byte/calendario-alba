rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Global Hardened Primitives
    // -----------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(email) {
      return email is string && email.size() >= 5 && email.size() <= 120 && email.matches('^[^/\\s@]+@[^/\\s@]+\\.[^/\\s@]+$');
    }

    function isValidDoorId(dayId) {
      return dayId is string && dayId.size() == 2 && dayId.matches('^(0[1-9]|1[0-9]|2[0-4])$');
    }

    function doorIdForDay(day) {
      return day < 10 ? ('0' + string(day)) : string(day);
    }

    function isValidClaimCode(code) {
      return code is string && code.size() == 17 && code.matches('^ALBA26-D(0[1-9]|1[0-9]|2[0-4])-[A-Z0-9]{6}$');
    }

    function isValidClaimCodeForDay(code, day) {
      return code is string && code.size() == 17 && code.matches('^ALBA26-D' + doorIdForDay(day) + '-[A-Z0-9]{6}$');
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && (
          request.auth.token.email == 'cetorrejon@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }

    // -----------------------------------------------------------------------
    // Validation Blueprints (Synchronized with firebase-blueprint.json)
    // -----------------------------------------------------------------------
    function isValidCampaignConfig(data) {
      return data.keys().hasAll([
          'salonName', 'campaignYear', 'startDate', 'endDate',
          'openHour', 'openMinute', 'closeHour', 'closeMinute',
          'timezone', 'validityEndDate', 'whatsappNumber',
          'instagramHandle', 'tiktokHandle', 'locationText', 'slogan',
          'conditions', 'founderPhotoUrl', 'founderPhotoMode',
          'simulationIso', 'testUnlockAll', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'salonName', 'campaignYear', 'startDate', 'endDate',
          'openHour', 'openMinute', 'closeHour', 'closeMinute',
          'timezone', 'validityEndDate', 'whatsappNumber',
          'instagramHandle', 'tiktokHandle', 'locationText', 'slogan',
          'conditions', 'founderPhotoUrl', 'founderPhotoMode',
          'simulationIso', 'testUnlockAll', 'updatedAt'
        ])
        && data.salonName is string && data.salonName.size() >= 2 && data.salonName.size() <= 80
        && data.campaignYear is int && data.campaignYear >= 2026 && data.campaignYear <= 2030
        && data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.openHour is int && data.openHour >= 0 && data.openHour <= 23
        && data.openMinute is int && data.openMinute >= 0 && data.openMinute <= 59
        && data.closeHour is int && data.closeHour >= 0 && data.closeHour <= 23
        && data.closeMinute is int && data.closeMinute >= 0 && data.closeMinute <= 59
        && data.timezone is string && data.timezone.size() >= 3 && data.timezone.size() <= 40
        && data.validityEndDate is string && data.validityEndDate.size() == 10 && data.validityEndDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 9 && data.whatsappNumber.size() <= 15 && data.whatsappNumber.matches('^[0-9]{9,15}$')
        && data.instagramHandle is string && data.instagramHandle.size() >= 2 && data.instagramHandle.size() <= 60
        && data.tiktokHandle is string && data.tiktokHandle.size() >= 2 && data.tiktokHandle.size() <= 60
        && data.locationText is string && data.locationText.size() >= 2 && data.locationText.size() <= 80
        && data.slogan is string && data.slogan.size() >= 5 && data.slogan.size() <= 220
        && data.conditions is list && data.conditions.size() >= 1 && data.conditions.size() <= 20
        && data.conditions[0] is string && data.conditions[0].size() <= 400
        && data.founderPhotoUrl is string && data.founderPhotoUrl.size() >= 5 && data.founderPhotoUrl.size() <= 200000
        && data.founderPhotoMode in ['fixed', 'editable']
        && (data.simulationIso == null || (data.simulationIso is string && data.simulationIso.size() >= 10 && data.simulationIso.size() <= 40))
        && data.testUnlockAll is bool
        && data.updatedAt is timestamp;
    }

    function isValidDoor(data, dayId) {
      return data.keys().hasAll(['day', 'prizeTitle', 'prizeDescription', 'prizeCategory', 'status', 'claimCode', 'updatedAt'])
        && data.keys().hasOnly(['day', 'prizeTitle', 'prizeDescription', 'prizeCategory', 'status', 'claimCode', 'updatedAt'])
        && data.day is int && data.day >= 1 && data.day <= 24
        && doorIdForDay(data.day) == dayId
        && data.prizeTitle is string && data.prizeTitle.size() >= 2 && data.prizeTitle.size() <= 160
        && data.prizeDescription is string && data.prizeDescription.size() >= 5 && data.prizeDescription.size() <= 500
        && data.prizeCategory is string && data.prizeCategory.size() >= 2 && data.prizeCategory.size() <= 40
        && data.status in ['available', 'claimed']
        && (
          (data.status == 'available' && data.claimCode == null)
          || (data.status == 'claimed' && isValidClaimCodeForDay(data.claimCode, data.day))
        )
        && data.updatedAt is timestamp;
    }

    function isValidClaim(data, claimCodeId) {
      return data.keys().hasAll([
          'day', 'prizeTitle', 'prizeDescription', 'prizeCategory',
          'claimCode', 'winnerRef', 'claimedAt', 'claimedAtMadrid',
          'redemptionStatus', 'redeemedAt', 'redeemedAtMadrid', 'redeemedNote'
        ])
        && data.keys().hasOnly([
          'day', 'prizeTitle', 'prizeDescription', 'prizeCategory',
          'claimCode', 'winnerRef', 'claimedAt', 'claimedAtMadrid',
          'redemptionStatus', 'redeemedAt', 'redeemedAtMadrid', 'redeemedNote'
        ])
        && data.day is int && data.day >= 1 && data.day <= 24
        && data.prizeTitle is string && data.prizeTitle.size() >= 2 && data.prizeTitle.size() <= 160
        && data.prizeDescription is string && data.prizeDescription.size() >= 5 && data.prizeDescription.size() <= 500
        && data.prizeCategory is string && data.prizeCategory.size() >= 2 && data.prizeCategory.size() <= 40
        && data.claimCode == claimCodeId
        && isValidClaimCodeForDay(data.claimCode, data.day)
        && data.winnerRef is string && data.winnerRef.size() == 15
        && data.winnerRef.matches('^GAN-' + doorIdForDay(data.day) + '-[A-F0-9]{8}$')
        && data.claimedAt is timestamp
        && data.claimedAtMadrid is string && data.claimedAtMadrid.size() >= 8 && data.claimedAtMadrid.size() <= 40
        && data.redemptionStatus in ['pending', 'redeemed']
        && (
          (data.redemptionStatus == 'pending' && data.redeemedAt == null && data.redeemedAtMadrid == null && data.redeemedNote == null)
          || (
            data.redemptionStatus == 'redeemed'
            && data.redeemedAt is timestamp
            && data.redeemedAtMadrid is string && data.redeemedAtMadrid.size() >= 8 && data.redeemedAtMadrid.size() <= 40
            && (data.redeemedNote == null || (data.redeemedNote is string && data.redeemedNote.size() <= 240))
          )
        );
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'details', 'actor', 'createdAt', 'createdAtMadrid'])
        && data.keys().hasOnly(['action', 'details', 'actor', 'createdAt', 'createdAtMadrid'])
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 60
        && data.details is string && data.details.size() >= 2 && data.details.size() <= 500
        && data.actor is string && data.actor.size() >= 2 && data.actor.size() <= 120
        && data.createdAt is timestamp
        && data.createdAtMadrid is string && data.createdAtMadrid.size() >= 8 && data.createdAtMadrid.size() <= 40;
    }

    function isValidAdminEntry(data, emailId) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'addedBy', 'createdAt'])
        && data.email == emailId
        && isValidEmailId(data.email)
        && data.addedBy is string && data.addedBy.size() >= 5 && data.addedBy.size() <= 120
        && data.createdAt is timestamp;
    }

    // Server-authoritative time check for Europe/Madrid in December (CET = UTC + 1h)
    function isDoorOpenForClaim(day) {
      let cfg = get(/databases/$(database)/documents/campaign/config).data;
      let madridNow = request.time + duration.value(1, 'h');
      let madridMinutes = madridNow.hours() * 60 + madridNow.minutes();
      let openMinutes = cfg.openHour * 60 + cfg.openMinute;
      let closeMinutes = cfg.closeHour * 60 + cfg.closeMinute;
      return cfg.testUnlockAll == true
        || cfg.simulationIso != null
        || (
          madridNow.year() == cfg.campaignYear
          && madridNow.month() == 12
          && madridNow.day() == day
          && madridMinutes >= openMinutes
          && madridMinutes <= closeMinutes
        );
    }

    // -----------------------------------------------------------------------
    // Collection Rules
    // -----------------------------------------------------------------------
    match /campaign/{configId} {
      allow get: if configId == 'config';
      allow list: if false;
      allow create, update: if isAdmin()
        && configId == 'config'
        && isValidCampaignConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /doors/{dayId} {
      allow get: if isValidDoorId(dayId);
      allow list: if existing().day >= 1 && existing().day <= 24;
      allow create: if isAdmin()
        && isValidDoorId(dayId)
        && isValidDoor(incoming(), dayId)
        && incoming().status == 'available'
        && incoming().claimCode == null
        && incoming().updatedAt == request.time;
      allow update: if isValidDoorId(dayId)
        && isValidDoor(incoming(), dayId)
        && incoming().updatedAt == request.time
        && (
          // Tier 1 (Admin): edit unclaimed prize details OR reset a door back to available
          (
            isAdmin() && (
              (
                existing().status == 'available'
                && incoming().status == 'available'
                && incoming().claimCode == null
                && incoming().diff(existing()).affectedKeys().hasOnly(['prizeTitle', 'prizeDescription', 'prizeCategory', 'updatedAt'])
              ) || (
                incoming().status == 'available'
                && incoming().claimCode == null
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimCode', 'updatedAt'])
              )
            )
          ) ||
          // Tier 2 (Public Atomic Claim): exactly one winner transitions available -> claimed with matching Claims doc
          (
            existing().status == 'available'
            && incoming().status == 'claimed'
            && incoming().day == existing().day
            && incoming().prizeTitle == existing().prizeTitle
            && incoming().prizeDescription == existing().prizeDescription
            && incoming().prizeCategory == existing().prizeCategory
            && isValidClaimCodeForDay(incoming().claimCode, existing().day)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimCode', 'updatedAt'])
            && isDoorOpenForClaim(existing().day)
            && existsAfter(/databases/$(database)/documents/claims/$(incoming().claimCode))
            && getAfter(/databases/$(database)/documents/claims/$(incoming().claimCode)).data.day == existing().day
            && getAfter(/databases/$(database)/documents/claims/$(incoming().claimCode)).data.claimCode == incoming().claimCode
          )
        );
      allow delete: if false;
    }

    match /claims/{claimCode} {
      // Public visitors can only fetch a single receipt by exact unguessable code; listing all winners is Admin-only
      allow get: if isValidClaimCode(claimCode);
      allow list: if isAdmin();

      // Atomic creation bound to door transition available -> claimed
      allow create: if isValidClaimCode(claimCode)
        && isValidClaim(incoming(), claimCode)
        && incoming().redemptionStatus == 'pending'
        && incoming().claimedAt == request.time
        && get(/databases/$(database)/documents/doors/$(doorIdForDay(incoming().day))).data.status == 'available'
        && get(/databases/$(database)/documents/doors/$(doorIdForDay(incoming().day))).data.prizeTitle == incoming().prizeTitle
        && get(/databases/$(database)/documents/doors/$(doorIdForDay(incoming().day))).data.prizeDescription == incoming().prizeDescription
        && get(/databases/$(database)/documents/doors/$(doorIdForDay(incoming().day))).data.prizeCategory == incoming().prizeCategory
        && getAfter(/databases/$(database)/documents/doors/$(doorIdForDay(incoming().day))).data.status == 'claimed'
        && getAfter(/databases/$(database)/documents/doors/$(doorIdForDay(incoming().day))).data.claimCode == claimCode;

      // Terminal State Locking: Admin can mark pending -> redeemed, irreversible once redeemed
      allow update: if isAdmin()
        && isValidClaimCode(claimCode)
        && isValidClaim(incoming(), claimCode)
        && existing().redemptionStatus == 'pending'
        && incoming().redemptionStatus == 'redeemed'
        && incoming().day == existing().day
        && incoming().prizeTitle == existing().prizeTitle
        && incoming().prizeDescription == existing().prizeDescription
        && incoming().prizeCategory == existing().prizeCategory
        && incoming().claimCode == existing().claimCode
        && incoming().winnerRef == existing().winnerRef
        && incoming().claimedAt == existing().claimedAt
        && incoming().claimedAtMadrid == existing().claimedAtMadrid
        && incoming().redeemedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['redemptionStatus', 'redeemedAt', 'redeemedAtMadrid', 'redeemedNote']);

      // Only Admin can delete a claim when atomically restoring its door back to available (test reset / exceptional void)
      allow delete: if isAdmin()
        && isValidClaimCode(claimCode)
        && getAfter(/databases/$(database)/documents/doors/$(doorIdForDay(existing().day))).data.status == 'available'
        && getAfter(/databases/$(database)/documents/doors/$(doorIdForDay(existing().day))).data.claimCode == null;
    }

    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /admins/{email} {
      allow get: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidEmailId(email)
        && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidEmailId(email)
        && isValidAdminEntry(incoming(), email)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidEmailId(email);
    }
  }
}
